# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.swo
*~
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Keep shareable VS Code configuration; ignore local editor state/settings.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.vs/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins
.pub-cache/
.pub/
**/build/
/coverage/
lcov.info

# Local SDK paths, native caches, and generated release packages.
**/local.properties
**/.gradle/
**/.kotlin/
**/.cxx/
*.apk
*.aab
*.ipa

# Environment values and private signing material (templates may be committed).
.env
.env.*
!.env.example
!.env.sample
!.env.template
**/key.properties
*.jks
*.keystore
*.p12
*.pfx

# Keep pubspec.lock and .metadata: this is a Flutter application.
# Platform-specific generated files are covered by each platform's .gitignore.

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
